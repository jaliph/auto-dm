[database]
# MSSQL Database Configuration
# Update these values with your actual MSSQL server details
mssql_server = localhost
mssql_database = whatsapp_automation
mssql_username = sa
mssql_password = YourStrong@Passw0rd

[api]
# API Server Configuration
# Port for the REST API server
port = :8080

[whatsapp]
# WhatsApp Connection Settings
# Interval in minutes to check WhatsApp client connections
connection_check_interval = 1

[files]
# File Sharing Settings
# Folder path where files to be shared are stored
share_folder = ./files

# Media Download Settings
# Folder path where received media files will be downloaded
receive_folder = ./received

[ollama]
# Ollama AI Integration Settings
# URL of the Ollama server (e.g., http://localhost:11434)
url = http://localhost:11434

# Name of the Ollama model to use for AI responses
model = llama2
